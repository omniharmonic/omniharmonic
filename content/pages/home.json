                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Leveraging the collective intelligence of all relevant participants in the co-design of socio-technical systems."
                        }
                      ]
                    }
                  ]
                },
                "image": {
                  "src": "media/2026/10/icon-03-pqcy.webp",
